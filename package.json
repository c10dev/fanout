{
  "name": "fanout",
  "version": "0.1.0",
  "description": "Video-first, self-hosted uploader: post one video to YouTube, TikTok, Instagram Reels, Facebook Reels, X, Bluesky and Mastodon using your own platform accounts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c10dev/fanout.git"
  },
  "keywords": [
    "youtube",
    "tiktok",
    "instagram",
    "facebook",
    "reels",
    "shorts",
    "uploader",
    "cross-posting",
    "self-hosted",
    "bluesky",
    "mastodon",
    "twitter"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fanout": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "fanout": "node src/cli.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
